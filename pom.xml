<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>dev.vuemind</groupId>
  <artifactId>vuemind-api</artifactId>
  <version>0.1.0</version>
  <name>vuemind-api</name>
  <description>
    Backend Spring Boot da carteira digital VueMind Wallet. Implementa o
    contrato em docs/contracts/vuemind-wallet-openapi.yaml (repo vuemind) com
    dados em memória — skeleton de estudo, sem banco/mensageria ainda.
  </description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!--
      Adicionado só para o endpoint de demo em wallet/reactive/ReactiveWalletController.java.
      Coexiste com o starter-web sem conflito: como o classpath tem Servlet (Tomcat)
      E Reactive Streams, o Spring Boot mantém WebApplicationType.SERVLET (deduceFromClasspath
      só escolhe REACTIVE quando NÃO há Servlet no classpath) — a aplicação continua toda
      em Tomcat/MVC, e o controller reativo só ganha o tipo Mono/Flux como retorno suportado
      pelo adaptador reativo do Spring MVC. Ver README para o pitch completo.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
